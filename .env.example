# Copy to .env and fill in. All variables are optional.

# Where experiment outputs land (defaults to ./outputs if unset).
CACHE_DIR=/path/to/your/cache/directory

# Weights & Biases (only needed if wandb.enabled=true).
WANDB_API_KEY=your_wandb_api_key_here
# WANDB_ENTITY=your_entity

# HuggingFace (only needed for gated models, e.g. Llama).
# HF_TOKEN=your_huggingface_token_here
